{
  "name": "school",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/write-vercel-json.mjs && node scripts/copy-pdf-worker.mjs",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "dev": "next dev",
    "jobs:dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "build": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --max-old-space-size=6144\" next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:tenant-schema": "tsx scripts/check-tenant-schema.ts",
    "db:functions:sync": "tsx scripts/db-functions/sync.ts",
    "db:functions:migrate": "tsx scripts/db-functions/migrate.ts",
    "gen:env-example": "tsx scripts/gen-env-example.ts",
    "migrate": "tsx scripts/guarded-drizzle-migrate.ts",
    "migrate:generate": "drizzle-kit generate",
    "db:preflight": "tsx scripts/preflight.ts",
    "db:reconcile-history": "tsx scripts/reconcile-drizzle-history.ts",
    "db:backfill-stripe-customer": "tsx scripts/backfill-stripe-customer.ts",
    "db:seed-dev": "tsx scripts/seed-dev.ts",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:all": "vitest run --project unit --project db",
    "test:isolation": "vitest run --project db tests/isolation",
    "test:watch": "vitest",
    "eval": "tsx evals/run.ts",
    "load-test:seed": "tsx scripts/load-test/seed.ts",
    "load-test:cleanup": "tsx scripts/load-test/cleanup.ts",
    "load-test:k6": "bash load-test/k6/run.sh"
  },
